    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.3",
    "vant": "^4.9.21",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@capacitor/cli": "^7.4.2",
